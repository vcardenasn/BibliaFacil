# BibliaFacil — copiar a .env y completar (NUNCA commitear .env)
APP_ENV=production
APP_NAME=BibliaFacil
APP_URL=https://biblia.example.com

# Token para public/check.php?key=<token> — generar uno largo y random
HEALTHCHECK_TOKEN=

# API.Bible — runtime solo para versiones con api_bible_id y scripts autorizados.
# Clave y reporte FUMS permanecen en servidor; nunca incluirla en Android.
API_BIBLE_KEY=

# Base de datos (formato canónico VCN — producción cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Opcional — dev local / tests sin MySQL:
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=storage/biblia.sqlite

# Feature flags (1 = activo)
FF_SEARCH=1
# Contador de visitas en el footer (tabla stats — upgrade_stats.sql)
FF_COUNTER=1
# Métricas anónimas agregadas (tablas metrics_* — upgrade_metrics.sql)
# Sin IP, sin cookies, sin texto del usuario. 0 = apaga track.php y contadores.
FF_METRICS=1
# PWA: manifest + service worker (lectura offline de capítulos visitados)
FF_PWA=1
# API JSON v1 para el cliente Android nativo (GET de catálogo/capítulos locales)
FF_NATIVE_API=0
